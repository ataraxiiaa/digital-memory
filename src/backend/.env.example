# Copy these variables into the workspace-root .env (do not overwrite existing values).
# Connection helpers load that file; deployment environment variables take precedence.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# A user's access token will come from authentication, not a shared env value.
# Never put sb_secret_ or legacy service_role keys into frontend configuration.
